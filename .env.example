# Google Sheets configuration
# SHEET_ID: the long alphanumeric string from the Google Sheet URL (between /d/ and /edit)
SHEET_ID=

# SHEET_NAME: the name of the tab within the Sheet; defaults to "Items" if not set
SHEET_NAME=Items

# Google Cloud service account credentials
# Create a service account in Google Cloud Console and download its JSON key file.

# GOOGLE_SERVICE_ACCOUNT_EMAIL: the email address from the service account's JSON key file
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# GOOGLE_PRIVATE_KEY: the private_key field from the service account's JSON key file
# Must include the full "-----BEGIN PRIVATE KEY-----" header and "-----END PRIVATE KEY-----" footer.
# The newlines in the key must be literal \n sequences (Vercel env vars store PEM this way).
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Anthropic API
# Get this from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Desk password
# Set this to a shared password that protects the /desk routes (queuing and sorting).
# When unset, all desk API requests are refused.
# The /submit endpoint is intentionally public and requires no password.
DESK_PASSWORD=

# Process API tuning (optional)
# Maximum items to process in one run; defaults to 3. Each item is a Claude API call,
# so raising this increases both cost and runtime. Keep it low enough that a full run
# finishes within Vercel's 300-second timeout.
MAX_ITEMS_PER_RUN=3

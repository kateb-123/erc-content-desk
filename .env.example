# Google Sheets configuration (via an Apps Script web app — see README.md)
# SHEET_API_URL: the deployed Apps Script web app URL (ends in /exec)
SHEET_API_URL=

# SHEET_API_TOKEN: the shared secret the app sends with every request; must match
# the SHEET_API_TOKEN script property set inside the Apps Script project
SHEET_API_TOKEN=

# Anthropic API
# Get this from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# GitHub publish (the Publish screen commits new rows to the Exchange repo)
# Fine-grained PAT with Contents: Read and write on kateb-123/erc-policy-exchange
GITHUB_TOKEN=

# Optional overrides — defaults shown
# HUB_REPO=kateb-123/erc-policy-exchange
# HUB_CSV_PATH=data/news.csv
# HUB_BRANCH=main

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/builder/newsletters/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "sandbox" }
      ]
    }
  ],
  "redirects": [
    { "source": "/public-pages/:path*", "destination": "https://erc-share.vercel.app/:path*", "permanent": false }
  ]
}
